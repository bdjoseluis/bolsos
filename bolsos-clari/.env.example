# ============================================================
#  .env.example — copia a .env y rellena los valores reales
#  NUNCA subas .env a git (ya está en .gitignore)
# ============================================================

# ── Postgres (Spring Boot) ───────────────────────────────────
POSTGRES_DB=bolsosdb
POSTGRES_USER=bolsos_user
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASEÑA

# ── Postgres (Odoo) ──────────────────────────────────────────
ODOO_DB_USER=odoo_user
ODOO_DB_PASSWORD=CAMBIA_ESTA_CONTRASEÑA

# ── Postgres (Windmill) ──────────────────────────────────────
WINDMILL_DB_NAME=windmill
WINDMILL_DB_USER=windmill_user
WINDMILL_DB_PASSWORD=CAMBIA_ESTA_CONTRASEÑA

# ── Formulario de contacto (frontend Angular) ────────────────
# Clave que el formulario manda en la cabecera X-Integration-Key.
# NO es un secreto: viaja al navegador dentro del bundle de Angular y
# cualquiera puede leerla con F12. La proteccion de verdad va en el
# servidor (rate limit por IP + comprobacion de Origin/Referer).
# Se inyecta en environment.prod.ts antes de compilar.
INTEGRACION_LEADS_CLAVE=CAMBIA_ESTA_CLAVE
